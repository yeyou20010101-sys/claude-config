{
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Bash(git check-ignore *)",
      "Bash(python scripts/build_agent_shells.py)",
      "Bash(python3 *)",
      "Bash(python *)",
      "Bash(git *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "timeout 10 git -C \"$HOME/.claude\" pull --rebase --quiet || true"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "git add -A"
          }
        ]
      },
      {
        "matcher": "Edit .*\\.(js|ts|jsx|tsx)$",
        "hooks": [
          {
            "type": "command",
            "command": "npx prettier --write \"$CLAUDE_TOOL_INPUT_FILE_PATH\"",
            "async": true
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$HOME/.claude\" && git add -A && git diff --cached --quiet || (git commit -m \"auto: sync $(hostname)\" && timeout 10 git push || true)"
          }
        ]
      }
    ]
  }
}
